---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import { getWPPosts, getWPPages, type WPPostWithEmbed } from '../lib/wp';
import { getGroupedTags } from '../utils/wordpress';

export async function getStaticPaths() {
  const posts = await getWPPosts();
  const pages = await getWPPages();
  
  // Combine all posts and pages that need single pages generated
  const allContent: WPPostWithEmbed[] = [...posts, ...pages];

  return allContent.map((item) => ({
    params: { slug: item.slug }, // Generates /:slug routes
    props: { content: item },
  }));
}

const { content } = Astro.props;

// Determine layout variant based on WP Category or Post Type
const terms = content._embedded?.['wp:term']?.flat() || [];
const categorySlugs = terms
  .filter((t: any) => t.taxonomy === 'category')
  .map((c: any) => c.slug.toLowerCase());

// Tag group parsing
const groupedTags = getGroupedTags(content);
const isTimelineEvent = Boolean(groupedTags['event'] && groupedTags['event'].length > 0);
const isProjectPost = categorySlugs.includes('projects') || categorySlugs.includes('project');

let layoutVariant = 'lead-broadside';

if (isProjectPost || categorySlugs.includes('case-studies')) {
  layoutVariant = 'project-star'; // Dedicated STAR layout for portfolio projects
} else if (categorySlugs.includes('opinion') || categorySlugs.includes('editorial')) {
  layoutVariant = 'editorial-single';
} else if (categorySlugs.includes('classifieds') || categorySlugs.includes('wire')) {
  layoutVariant = 'classified-wire';
}
---
<BaseLayout title={content.title.rendered}>
  <article class={`newspaper-wrapper layout-${layoutVariant}`}>
    <section class="content-wrapper">

      {/* HEADER BANNER SELECTION */}
      {isTimelineEvent ? (
        <div class="archive-header-banner">
          <p class="tagline">// CHRONOLOGICAL REGISTER</p>
          <h1 class="archive-title">THE DIGITAL TIMELINE</h1>
          <p class="archive-subtitle">
            RECORDED MILESTONES, SYSTEM EVENTS, AND ARCHITECTURAL DISPATCHES
          </p>
        </div>
      ) : isProjectPost ? (
        <div class="archive-header-banner">
          <p class="tagline">// CLASSIFIED PROJECT DOSSIERS & REPORTS</p>
          <h1 class="archive-title">THE BUILDER'S GAZETTE</h1>
          <p class="archive-subtitle">
            SPECIAL REPORT: ARCHIVED WORKS, SYSTEM ARCHITECTURES, AND EXPERIMENTAL LOGIC
          </p>
        </div>
      ) : (
        <div class="archive-header-banner">
          <p class="tagline">// CLASSIFIED DISPATCHES & RECORDS</p>
          <h1 class="archive-title">THE ARCHIVE</h1>
          <p class="archive-subtitle">
            A COMPLETE CHRONICLE OF LOGIC, ARCHITECTURE, AND SYSTEM DISPATCHES
          </p>
        </div>
      )}

      {/* VARIANT A: PROJECT PORTFOLIO (STAR Broadside + Tech Stack Specs) */}
      {layoutVariant === 'project-star' && (
        <div class="variant-project">
          <header class="dispatch-header">
            <p class="tagline">// DISPATCH: TECHNICAL PROJECT BRIEF</p>
            <h1 class="headline" set:html={content.title.rendered}></h1>
            <div class="dispatch-meta">
              <span class="mono-label">DATE: {new Date(content.date).toLocaleDateString()}</span>
              <span class="mono-label">TYPE: PORTFOLIO BRIEF</span>
            </div>
          </header>

          <div class="article-grid-broadside">
            <aside class="sidebar">
              <div class="tech-stack-container">
                <h3 class="technology-heading">PROJECT SPECIFICATIONS</h3>
                <ul class="meta-list">
                  <li>SLUG <span>/{content.slug}</span></li>
                  <li>FRAMEWORK <span>STAR ENGINE</span></li>
                  <li>STATUS <span>DEPLOYED</span></li>
                </ul>
              </div>
            </aside>

            <main class="main-article">
              <div class="wp-newspaper-content wp-content star-flow" set:html={content.content.rendered}></div>
            </main>
          </div>
        </div>
      )}

      {/* VARIANT B: EDITORIAL OP-ED */}
      {layoutVariant === 'editorial-single' && (
        <div class="variant-editorial">
          <div class="editorial-box">
            <header class="editorial-header">
              <span class="tagline">// OPINION & EDITORIAL</span>
              <h1 class="headline editorial-headline" set:html={content.title.rendered}></h1>
              <div class="author-byline">
                <span class="mono-label">BY THE EDITORIAL BOARD</span>
                <span class="mono-label">•</span>
                <span class="mono-label">{new Date(content.date).toLocaleDateString()}</span>
              </div>
            </header>

            <main class="editorial-body">
              <div class="wp-newspaper-content single-col" set:html={content.content.rendered}></div>
            </main>
          </div>
        </div>
      )}

      {/* VARIANT C: CLASSIFIED WIRE */}
      {(layoutVariant === 'classified-wire') && (
        <div class="variant-wire">
          <header class="wire-header">
            <div class="wire-badge">TELETYPE TRANSMISSION</div>
            <h1 class="headline wire-headline" set:html={content.title.rendered}></h1>
          </header>

          <div class="article-grid-wire">
            <main class="main-article">
              <div class="wp-newspaper-content three-col" set:html={content.content.rendered}></div>
            </main>

            <aside class="sidebar right-sidebar">
              <div class="tech-stack-container">
                <h3 class="technology-heading">WIRE METADATA</h3>
                <ul class="meta-list">
                  <li>ID <span>#{content.id}</span></li>
                  <li>DATE <span>{new Date(content.date).toLocaleDateString()}</span></li>
                </ul>
              </div>
            </aside>
          </div>
        </div>
      )}

      {/* VARIANT D: STANDARD POST */}
      {(layoutVariant === 'lead-broadside') && (
        <div class="variant-wire">
          <header class="wire-header">
            <div class="wire-badge">TELETYPE TRANSMISSION</div>
            <h1 class="headline wire-headline" set:html={content.title.rendered}></h1>
          </header>

          <div class="article-grid-wire">
            <main class="main-article">
              <div class="wp-newspaper-content" set:html={content.content.rendered}></div>
            </main>

            <aside class="sidebar right-sidebar">
              <div class="tech-stack-container">
                <h3 class="technology-heading">WIRE METADATA</h3>
                <ul class="meta-list">
                  <li>ID <span>#{content.id}</span></li>
                  <li>DATE <span>{new Date(content.date).toLocaleDateString()}</span></li>
                </ul>
              </div>
            </aside>
          </div>
        </div>
      )}

    </section>
  </article>
</BaseLayout>

<style>
  .newspaper-wrapper {
    width: 100%;
    min-height: 100vh;
  }

  .content-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem 1.5rem;
  }

  /* Header Banner Styles */
  .archive-header-banner {
    text-align: center;
    border-bottom: 4px solid var(--ink);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .archive-title {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1;
    margin: 0.5rem 0;
  }

  .archive-subtitle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* Common Typography & Headings */
  .tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
  }

  .headline {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-weight: 900;
    line-height: 1.05;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .technology-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 900;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3rem;
    margin-bottom: 0.75rem;
  }

  .meta-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .meta-list li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    border-bottom: 1px solid var(--ink);
    padding: 0.3rem 0;
  }

  /* Base Body Text & Drop Cap */
  .wp-newspaper-content {
    font-family: serif;
    font-size: 1.1rem;
    line-height: 1.6;
    text-align: justify;
  }

  .wp-newspaper-content :global(p) {
    margin-bottom: 1rem;
  }

  .wp-newspaper-content :global(> p:first-of-type)::first-letter {
    font-family: var(--font-serif);
    font-size: 4rem;
    float: left;
    line-height: 0.75;
    padding-bottom: 0.2rem;
    margin-right: 8px;
    font-weight: 900;
  }

  /* ================= WORDPRESS TABLES ================= */
  .wp-newspaper-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-family: serif;
    font-size: 0.95rem;
    border: 2px solid var(--ink);
  }

  .wp-newspaper-content :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    background-color: var(--ink);
    color: var(--off-white);
    padding: 0.5rem 0.75rem;
    text-align: left;
    border: 1px solid var(--ink);
  }

  .wp-newspaper-content :global(td) {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--ink);
    vertical-align: top;
  }

  .wp-newspaper-content :global(tr:nth-child(even)) {
    background-color: rgba(0, 0, 0, 0.03);
  }

  /* Figure wrapper for Gutenberg Table Blocks */
  .wp-newspaper-content :global(figure.wp-block-table) {
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  /* ================= CODE BLOCKS (<pre><code>) ================= */
  .wp-newspaper-content :global(pre) {
    background-color: #121212;
    color: #00ff66;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 1.25rem;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0px var(--ink);
    overflow-x: auto;
    margin: 1.5rem 0;
    white-space: pre;
    word-spacing: normal;
    word-break: normal;
    word-wrap: normal;
    line-height: 1.5;
  }

  /* Inline or Nested <code> inside <pre> */
  .wp-newspaper-content :global(pre code) {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: transparent;
    padding: 0;
    border: none;
  }

  /* Standalone Inline <code> (outside <pre>) */
  .wp-newspaper-content :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: rgba(0, 0, 0, 0.08);
    color: var(--ink);
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--ink);
  }

  /* Prevent drop caps from touching code or tables */
  .wp-newspaper-content :global(pre code::first-letter),
  .wp-newspaper-content :global(table::first-letter) {
    font-size: inherit !important;
    float: none !important;
    margin: 0 !important;
  }

  /* ================= VARIANT 1: BROADSIDE ================= */
  .dispatch-header {
    border-bottom: 4px solid var(--ink);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .dispatch-header .headline {
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin: 0.5rem 0 1rem 0;
  }

  .dispatch-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    border-top: 1px solid var(--ink);
    padding-top: 0.75rem;
  }

  .article-grid-broadside {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-right: 2px solid var(--ink);
    padding-right: 2.5rem;
  }

  .placeholder-img {
    width: 100%;
    height: 160px;
    background: repeating-linear-gradient(45deg, #ccc, #ccc 10px, #eee 10px, #eee 20px);
    border: 2px solid var(--ink);
  }

  .figure-caption {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    margin-top: 0.5rem;
  }

  .wp-newspaper-content.two-col {
    column-count: 2;
    column-gap: 2rem;
    column-rule: 1px solid var(--ink);
  }

  /* ================= VARIANT 2: EDITORIAL (SINGLE COL) ================= */
  .editorial-box {
    max-width: 780px;
    margin: 0 auto;
    border: 3px solid var(--ink);
    padding: 3rem;
    background: var(--off-white);
  }

  .editorial-header {
    text-align: center;
    border-bottom: 2px double var(--ink);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .editorial-headline {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 0.75rem 0;
    font-style: italic;
  }

  .author-byline {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .wp-newspaper-content.single-col {
    column-count: 1;
    font-size: 1.2rem;
    line-height: 1.7;
  }

  /* ================= VARIANT 3: WIRE TRANSMISSION ================= */
  .wire-header {
    border-bottom: 2px dashed var(--ink);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .wire-badge {
    display: inline-block;
    background: var(--ink);
    color: var(--off-white);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    margin-bottom: 0.5rem;
  }

  .wire-headline {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }

  .article-grid-wire {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 2.5rem;
    align-items: start;
  }

  .sidebar.right-sidebar {
    border-right: none;
    border-left: 2px solid var(--ink);
    padding-right: 0;
    padding-left: 2rem;
  }

  .wp-newspaper-content.three-col {
    column-count: 3;
    column-gap: 1.5rem;
    column-rule: 1px solid var(--ink);
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .article-grid-broadside,
    .article-grid-wire {
      grid-template-columns: 1fr;
    }

    .sidebar, .sidebar.right-sidebar {
      border: none;
      border-bottom: 2px solid var(--ink);
      padding: 0 0 2rem 0;
    }

    .wp-newspaper-content.two-col,
    .wp-newspaper-content.three-col {
      column-count: 1;
    }

    .editorial-box {
      padding: 1.5rem;
    }
  }

  /* ================= PROJECT ARTICLE / STAR BLOCK STYLES ================= */
  
  /* WordPress Columns inside Projects */
  .wp-content :global(.wp-block-columns) {
    display: flex;
    gap: 1.5rem;
    border-top: 3px double var(--ink);
    border-bottom: 3px double var(--ink);
    padding: 1.5rem 0;
    margin: 2rem 0;
  }

  .wp-content :global(.wp-block-column) {
    flex: 1;
    border-right: 1px solid var(--ink);
    padding-right: 1.5rem;
  }

  .wp-content :global(.wp-block-column:last-child) {
    border-right: none;
    padding-right: 0;
  }

  /* Column Headers (Situation / Task / Action / Result) */
  .wp-content :global(h3) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
    background-color: var(--ink);
    color: var(--off-white);
    display: inline-block;
    padding: 4px 8px;
  }

  /* Retro CRT Terminal Developer Commentary Blockquote */
  .wp-content :global(blockquote), 
  .wp-content :global(.wp-block-quote) {
    border: 2px solid var(--ink);
    background-color: #121212;
    color: #33ff33;
    padding: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin: 2rem 0;
    box-shadow: 4px 4px 0px var(--ink);
    position: relative;
  }

  .wp-content :global(blockquote::before),
  .wp-content :global(.wp-block-quote::before) {
    content: "DEV_LOG // AUTHOR COMMENTARY";
    display: block;
    font-weight: bold;
    letter-spacing: 1px;
    background: var(--ink);
    color: var(--off-white);
    margin: -1.25rem -1.25rem 1rem -1.25rem;
    padding: 0.3rem 0.75rem;
    font-size: 0.7rem;
    border-bottom: 2px solid var(--ink);
  }

  .wp-content :global(blockquote p),
  .wp-content :global(.wp-block-quote p) {
    margin: 0;
    color: #00ff66;
    font-family: var(--font-mono);
  }

  .wp-content :global(blockquote cite),
  .wp-content :global(.wp-block-quote cite) {
    display: block;
    margin-top: 0.75rem;
    color: #888;
    font-size: 0.7rem;
    font-style: normal;
  }
</style>