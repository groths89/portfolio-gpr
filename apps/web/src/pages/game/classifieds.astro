---
import NewspaperLayout from "../../layouts/NewspaperLayout.astro";
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import { faEnvelope } from "@fortawesome/free-solid-svg-icons";
import { faRss } from "@fortawesome/free-solid-svg-icons";
import { getSingleWPPage, type WPPostWithEmbed } from "../../lib/wp.ts";

library.add(faEnvelope, faRss);

const emailicon = icon({ prefix: "fas", iconName: "envelope" }).html.join("");
const rssicon = icon({ prefix: "fas", iconName: "rss" }).html.join("");

const wpClassifiedsPage: WPPostWithEmbed | null =
  await getSingleWPPage("classifieds-page");
const crosswordLayout = [
  "xxx############",
  "#x##x#######x##",
  "xxxxx#x#x#xxxx#",
  "#x##x#x#x###x##",
  "####x#x#x###x##",
  "####x#x#x#xxxxx",
  "####x#x#x##x##x",
  "####xxxxxxxx##x",
  "#####x##x##x##x",
  "#####xxx#xxx##x",
  "#####x#########",
  "###xxx#########",
];
const crosswordNumbers: Record<string, number> = {
  "0-0": 1,
  "0-1": 2,
  "1-4": 3,
  "1-12": 4,
  "2-0": 5,
  "2-6": 6,
  "2-8": 7,
  "2-10": 8,
  "5-10": 9,
  "5-11": 10,
  "5-14": 11,
  "7-4": 12,
  "7-5": 13,
  "9-5": 14,
  "9-9": 15,
  "11-3": 16,
};
---

<NewspaperLayout
  pageId="classifieds-page" 
  title="Classifieds | Newspaper"
  issueDate="DECEMBER 31, 1989"
  volume="VOL. 104"
  issueNumber="NO. 365"
  editionName="YEAR-END CLEARANCE & RECAP"
>
    <section id="content" class="content-wrapper classifieds-content">
      <header class="classifieds-heading">
        <p>THE 1989 EDITION / LOCAL NOTICES</p>
        <h1>CLASSIFIEDS</h1>
        <p>VOL. 32,841 / AVAILABLE FOR IMMEDIATE REPLY</p>
      </header>
      <div class="classifieds-layout">
        <section class="classifieds-ads" aria-label="Classified advertisements">
          {
            wpClassifiedsPage ? (
              <div
                id="classifieds-source"
                class="wp-rendered-content"
                set:html={wpClassifiedsPage.content.rendered}
              />
            ) : (
              <p class="empty-classifieds">New listings arriving shortly.</p>
            )
          }
        </section>
        <section class="crossword-panel" aria-labelledby="crossword-title">
          <div class="puzzle-title">
            <p>PUZZLE NO. 1989</p>
            <h2 id="crossword-title">THE CODEWORD</h2>
          </div>
          <div class="crossword-grid" aria-label="1989 crossword puzzle">
            {
              crosswordLayout.map((row, rowIndex) =>
                [...row].map((cell, columnIndex) =>
                  cell === "x" ? (
                    <label
                      class={`crossword-cell ${columnIndex === 12 && rowIndex >= 1 && rowIndex <= 5 ? "escape-word" : ""} ${rowIndex === 1 && columnIndex === 12 ? "escape-word-start escape-word-number" : ""} ${rowIndex === 5 && columnIndex === 12 ? "escape-word-end" : ""}`}
                    >
                      {crosswordNumbers[`${rowIndex}-${columnIndex}`] && (
                        <span class="crossword-number">
                          {crosswordNumbers[`${rowIndex}-${columnIndex}`]}
                        </span>
                      )}
                      <input
                        type="text"
                        maxlength="1"
                        aria-label={`Row ${rowIndex + 1}, column ${columnIndex + 1}`}
                      />
                    </label>
                  ) : (
                    <span class="crossword-block" aria-hidden="true" />
                  ),
                ),
              )
            }
          </div>
          <div class="crossword-clues">
            <div>
              <h3>ACROSS</h3>
              <p><strong>1.</strong> Bulletin-board community, briefly</p>
              <p><strong>5.</strong> Desktop pointing device</p>
              <p><strong>8.</strong> Magnetic storage medium</p>
              <p><strong>9.</strong> Commodore home computer</p>
              <p><strong>12.</strong> Computer input device with keys</p>
              <p><strong>14.</strong> Computer working memory, briefly</p>
              <p><strong>15.</strong> Company behind the PC/AT</p>
              <p><strong>16.</strong> Read-only memory, briefly</p>
            </div>
            <div>
              <h3>DOWN</h3>
              <p><strong>2.</strong> Firmware that starts a PC</p>
              <p><strong>3.</strong> Computer-to-computer connection</p>
              <p><strong>4.</strong> Character-encoding standard</p>
              <p><strong>6.</strong> Flexible magnetic disk</p>
              <p><strong>7.</strong> Video display device</p>
              <p><strong>10.</strong> Dial-up device</p>
              <p><strong>11.</strong> Computer family</p>
              <p><strong>13.</strong> Erasable programmable chip</p>
            </div>
          </div>
        </section>
        <section
          id="classifieds-right"
          class="classifieds-ads classifieds-ads-right"
          aria-label="More classified advertisements"
        >
        </section>
      </div>
            <div id="section-3" class="section-3">
        <div>
          <div>
            <span>Quick Clips:</span>
          </div>
          <div>Weather: Cloud Infrastructure Stable</div>
          <div>Stocks: Semiconductor Futures Rising</div>
          <div>Obituaries: Legacy IE Support Laid to Rest</div>
          <div id="buttons" class="buttons">
            <Fragment set:html={rssicon} />
            <Fragment set:html={emailicon} />
          </div>
        </div>
      </div>
    </section>
</NewspaperLayout>
<style>
  .newspaper-wrapper {
    width: 100%;
    min-height: 100vh;
  }

  .content-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem;
  }

  .edition-banner {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 0.4rem 0;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  /* SPORTS LAYOUT GRID */
  .sports-layout {
    display: grid;
    grid-template-columns: 2.2fr 1.2fr;
    gap: 2rem;
    border-bottom: 4px solid var(--ink);
    padding-bottom: 2rem;
  }

  @media (max-width: 900px) {
    .sports-layout {
      grid-template-columns: 1fr;
    }
  }

  .sports-main-stories {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sports-data-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-left: 2px solid var(--ink);
    padding-left: 1.5rem;
  }

  @media (max-width: 900px) {
    .sports-data-sidebar {
      border-left: none;
      padding-left: 0;
      border-top: 2px solid var(--ink);
      padding-top: 1.5rem;
    }
  }

  /* STANDINGS TABLES */
  .data-box {
    border: 1px solid var(--ink);
    padding: 0.8rem;
    background: var(--off-white);
  }

  .table-title,
  :global(.wp-rendered-content h3) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.3rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.5px;
  }

  .standings-table,
  :global(.wp-rendered-content table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: right;
  }

  .standings-table th,
  :global(.wp-rendered-content th) {
    border-bottom: 1px solid var(--ink);
    padding: 0.2rem 0.4rem;
    font-weight: 700;
  }

  .standings-table td,
  :global(.wp-rendered-content td) {
    padding: 0.25rem 0.4rem;
    border-bottom: 1px dotted var(--ink);
  }

  .standings-table th:first-child,
  .standings-table td:first-child,
  :global(.wp-rendered-content th:first-child),
  :global(.wp-rendered-content td:first-child) {
    text-align: left;
  }

  :global(#sports-page .sports-decoder-table) {
    cursor: crosshair;
    position: relative;
  }

  :global(#sports-page .sports-decoder-note) {
    border: 1px solid #b42318;
    background: var(--off-white);
    clip-path: circle(0 at var(--uv-x, 50%) var(--uv-y, 50%));
    color: #9b1c1c;
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    line-height: 1.35;
    margin-top: 0.75rem;
    padding: 0.45rem;
    transform: rotate(-1deg);
    transition: clip-path 0.1s ease-out;
  }

  :global(#sports-page .sports-decoder-note.uv-active) {
    clip-path: circle(42px at var(--uv-x, 50%) var(--uv-y, 50%));
    text-shadow: 0 0 4px rgba(180, 35, 24, 0.35);
  }

  .highlight-row {
    font-weight: 900;
    background: rgba(0, 0, 0, 0.05);
  }

  /* UNIVERSAL MULTI-COLUMN BROADSHEET (Applied to both static & WP rendered markup) */
  .newspaper-columns {
    column-count: 3;
    column-gap: 2rem;
    column-rule: 1px solid var(--ink);
    border-bottom: 4px solid var(--ink);
    padding-bottom: 2rem;
    width: 100%;
  }

  /* CLASSIFIEDS: a wider center track keeps the puzzle as the page focal point. */
  .classifieds-heading {
    border-bottom: 3px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding-bottom: 0.6rem;
    text-align: center;
  }

  .classifieds-heading h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    line-height: 1;
  }

  .classifieds-layout {
    display: grid;
    grid-template-columns: minmax(160px, 0.8fr) minmax(360px, 1.8fr) minmax(
        160px,
        0.8fr
      );
    gap: 1.5rem;
    padding: 1.5rem 0 2rem;
  }

  .classifieds-ads,
  .classifieds-ads-right {
    font-family: serif;
  }

  .classifieds-ads {
    border-right: 1px solid var(--ink);
    padding-right: 1.5rem;
  }
  .classifieds-ads-right {
    border-left: 1px solid var(--ink);
    padding-left: 1.5rem;
  }
  .empty-classifieds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .crossword-panel {
    min-width: 0;
  }
  .puzzle-title {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.45rem;
    text-align: center;
  }
  .crossword-clues {
    font-family: var(--font-mono);
  }
  .puzzle-title h2 {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    line-height: 1.1;
  }

  .crossword-grid {
    aspect-ratio: 15 / 12;
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    grid-template-rows: repeat(12, 1fr);
    margin: 1rem auto;
    max-width: 540px;
    width: 100%;
  }

  .crossword-cell,
  .crossword-block {
    border: 1px solid var(--ink);
    border-radius: 0;
    min-width: 0;
  }
  .crossword-cell {
    position: relative;
  }
  .escape-word::after {
    content: none;
  }
  .escape-word-start::after {
    border: 3px solid #b42318;
    border-radius: 45% 52% 49% 46%;
    content: "";
    height: calc(500% + 8px);
    left: -5px;
    pointer-events: none;
    position: absolute;
    top: -5px;
    transform: rotate(-3deg);
    width: calc(100% + 10px);
    z-index: 1;
  }
  .escape-word-start::before {
    border: 1px solid rgba(180, 35, 24, 0.75);
    border-radius: 52% 44% 50% 55%;
    content: "";
    height: calc(500% + 4px);
    left: -3px;
    pointer-events: none;
    position: absolute;
    top: -2px;
    transform: rotate(2deg);
    width: calc(100% + 6px);
    z-index: 1;
  }
  .escape-word-number .crossword-number {
    background: var(--off-white);
    padding: 0 1px;
    z-index: 2;
  }
  .crossword-grid input {
    background: transparent;
    border: 0;
    height: 100%;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.6rem);
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }
  .crossword-number {
    font-family: var(--font-mono);
    font-size: clamp(0.38rem, 0.9vw, 0.55rem);
    left: 2px;
    line-height: 1;
    position: absolute;
    top: 2px;
  }
  .crossword-grid input:focus {
    background: #d8efec;
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .crossword-block {
    background: var(--ink);
  }
  .crossword-clues {
    border-top: 1px solid var(--ink);
    display: grid;
    font-size: 0.62rem;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
    line-height: 1.25;
    padding-top: 0.65rem;
    text-transform: none;
  }
  .crossword-clues h3 {
    font-size: 0.7rem;
    margin-bottom: 0.35rem;
  }
  .crossword-clues p + p {
    margin-top: 0.45rem;
  }
  @media (max-width: 760px) {
    .classifieds-layout {
      grid-template-columns: 1fr;
    }
    .classifieds-ads,
    .classifieds-ads-right {
      border: 0;
      padding: 0;
    }
    .crossword-panel {
      border-bottom: 2px solid var(--ink);
      border-top: 2px solid var(--ink);
      padding: 1.25rem 0;
    }
    .crossword-clues {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1024px) {
    .newspaper-columns {
      column-count: 2;
    }
  }

  @media (max-width: 650px) {
    .newspaper-columns {
      column-count: 1;
      column-rule: none;
    }
  }

  /* STATIC ARTICLE BREAK PREVENTIONS */
  .news-article {
    break-inside: avoid;
    page-break-inside: avoid;
    display: block;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .lead-article {
    column-span: all;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .headline-h1 {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.05;
    margin: 0.4rem 0;
  }

  .headline-h2 {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0.4rem 0;
  }

  .byline {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--ink);
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.2rem;
    display: inline-block;
  }

  .article-body {
    font-family: serif;
    font-size: 1rem;
    line-height: 1.5;
    text-align: justify;
  }

  .article-body p {
    margin-bottom: 0.8rem;
  }

  .drop-cap::first-letter {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    float: left;
    line-height: 0.75;
    padding-bottom: 0.1rem;
    margin-right: 6px;
    color: var(--ink);
    font-weight: 900;
  }

  .developer-commentary {
    background: var(--off-white);
    border: 2px solid var(--ink);
    border-left: 5px solid var(--ink);
    padding: 0.8rem;
    margin: 1rem 0 0.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .developer-commentary p {
    margin-bottom: 0.4rem;
  }

  .developer-commentary p:last-child {
    margin-bottom: 0;
  }

  :global(#tech-page .tech-cipher-letter) {
    background: var(--ink);
    color: var(--ink);
    display: inline;
    transition:
      background 0.35s ease,
      color 0.35s ease;
  }

  :global(#tech-page .tech-cipher-letter.revealed) {
    background: rgba(42, 32, 15, 0.52);
    color: #241e10;
    text-shadow: 0 0 4px rgba(230, 174, 28, 0.65);
  }

  /* -------------------------------------------------------------
	   STRICT NEWSPAPER COLUMN FORMATTING FOR DYNAMIC WORDPRESS HTML 
	   ------------------------------------------------------------- */
  :global(.wp-rendered-content h1) {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.05;
    margin: 0.5rem 0 1rem 0;
    column-span: all; /* Main title spans across all columns */
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.5rem;
  }

  :global(.wp-rendered-content h2) {
    font-family: var(--font-serif);
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 1.5rem 0 0.5rem 0;
    break-after: avoid;
    break-inside: avoid;
  }

  :global(.wp-rendered-content h3),
  :global(.wp-rendered-content h4) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0.5rem 0 0.8rem 0;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.2rem;
    break-after: avoid;
    break-inside: avoid;
  }

  :global(.wp-rendered-content p) {
    font-family: serif;
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 0.8rem;
    text-align: justify;
    orphans: 2;
    widows: 2;
  }

  :global(.wp-rendered-content blockquote) {
    background: var(--off-white);
    border: 2px solid var(--ink);
    border-left: 5px solid var(--ink);
    padding: 0.8rem;
    margin: 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.4;
    break-inside: avoid;
  }

  :global(.wp-rendered-content figure),
  :global(.wp-rendered-content img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1rem 0;
    border: 1px solid var(--ink);
    break-inside: avoid;
  }

  :global(.wp-rendered-content .wp-block-columns),
  :global(.wp-rendered-content .wp-block-group) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  /* SECTION 3 BOTTOM BAR */
  .section-3 {
    width: 100%;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 8pt;
    text-transform: uppercase;
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .section-3 > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .buttons {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .buttons :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* SCROLL INDICATOR BUTTON */
  .scroll-indicator {
    position: fixed;
    bottom: 6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    background: var(--off-white);
    border: 2px solid var(--ink);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    border-radius: 50px;
    box-shadow: 0px 8px 0px var(--ink);
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }

  .scroll-indicator:hover {
    animation-play-state: paused;
    background: var(--ink);
    color: var(--off-white);
    transform: translateX(-50%) translateY(-2px);
    box-shadow: 0px 4px 0px var(--ink);
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    font-weight: 700;
    writing-mode: vertical-rl;
    letter-spacing: 2px;
    color: var(--ink);
  }

  .scroll-indicator:hover .scroll-text,
  .scroll-indicator:hover .scroll-icon {
    color: var(--off-white);
  }

  .scroll-icon {
    font-size: 1.2rem;
  }
</style>
